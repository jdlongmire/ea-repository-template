{
  "common_required": ["id", "type", "name", "level", "owner", "status"],
  "id_pattern": "^[A-Z]{2,5}(-[A-Z0-9]+)*-[0-9]{3}$",
  "levels": ["enterprise", "systems", "solutions", "cross-cutting"],
  "statuses": ["draft", "proposed", "ratified", "current", "target", "deprecated", "closed"],
  "relation_types": ["realizes", "uses", "bound-by", "allocated-to", "decided-by", "delivers", "depends-on"],
  "view_levels": ["enterprise", "systems", "solutions", "cross-level"],
  "view_focus_areas": ["strategy", "architecture", "roadmaps", "standards", "traceability"],
  "types": {
    "strategy": {},
    "requirement": {},
    "capability": {},
    "system": {"extra_required": ["interfaces", "standards"]},
    "interface": {},
    "standard": {"extra_required": ["enforcement"], "enforcement_values": ["policy", "review"]},
    "decision": {},
    "roadmap": {},
    "work-package": {},
    "solution": {"extra_required": ["system"]},
    "evidence": {"extra_required": ["state_kind", "subject", "source", "method", "observed_at", "confidence"],
      "field_values": {"state_kind": ["declared", "observed", "inferred"], "confidence": ["high", "medium", "low"]}},
    "drift": {"extra_required": ["subject", "classification", "evidence"],
      "field_values": {"classification": ["defect", "model-error", "sensor-error", "undetermined"]}}
  }
}
